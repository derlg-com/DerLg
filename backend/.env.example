# =============================================================================
# DerLg Backend — Environment Variables
# =============================================================================
# Copy this file to .env (dev) or .env.production (prod) and fill in values.
# Never commit real secrets.
#
# Development: self-hosted Postgres, Redis and MinIO via backend/docker-compose.yml.
# Production: Docker for PostgreSQL, Redis, and MinIO.
#
# Supabase is NOT used, in the cloud or as a local stack. DerLg owns its own
# Postgres in every environment.
# =============================================================================

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
PORT=5001
NODE_ENV=development
# =============================================================================
# Payments — Stripe (cards)
# =============================================================================
# Secret key. NEVER the publishable key (pk_...) — that one goes in the web app.
# Empty disables card payments: /v1/payments/intents answers 503 and the
# catalogue, AI concierge and ABA payments keep working.
STRIPE_SECRET_KEY=

# Webhook signing secret. Get it from `stripe listen --forward-to
# localhost:4007/v1/payments/stripe/webhook` in dev, or from the endpoint in the
# Stripe dashboard in production.
#
# This is what makes a payment real. The browser is never trusted to report
# success — only Stripe's signed server-to-server callback marks a booking paid,
# so with this unset the webhook fails closed and cards can never settle.
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# Payments — ABA Bank (dynamic KHQR)
# =============================================================================
# ABA publishes no payment API, so this integration uses the two open surfaces
# that exist: the KHQR spec to mint a QR with the amount pre-filled, and the
# Telegram credit alert ABA's bot posts when money arrives.
#
# Your STATIC merchant KHQR string from ABA onboarding (the QR on the merchant
# card, or the merchant portal). Starts with "000201" and contains "010211".
# The server flips it to dynamic, injects the amount and an expiry, and
# recomputes the checksum.
#
# Not a secret — it is encoded into every QR a customer sees — but it IS the
# merchant identifier, so a wrong value sends customer money to another account.
ABA_STATIC_QR=

# How long a generated QR stays payable. Capped below the 15-minute booking hold:
# a QR outliving its hold lets a customer pay for inventory already released.
ABA_QR_TTL_MINUTES=10

# Telegram group where ABA's bot posts credit alerts, in "marked" form.
# Find it by forwarding a message from the group to @userinfobot.
ABA_TELEGRAM_GROUP_ID=

# Comma-separated Telegram user ids permitted to settle a payment.
#
# SET THIS. Group membership is not authorisation: with the allowlist empty,
# anyone who can post in the group can send text matching ABA's alert format and
# confirm a booking nobody paid for. The listener warns at startup when it is
# empty.
ABA_ALERT_SENDER_IDS=

# =============================================================================
# Telegram MTProto (GramJS) — the userbot that reads ABA's credit alerts
# =============================================================================
# A user account, not a bot. The Bot API forbids one bot from reading another
# bot's messages, so a Bot API listener would connect and then never see a single
# ABA alert.
#
# api_id / api_hash from https://my.telegram.org → "API development tools".
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Generated once by `npm run telegram:login`.
#
# This is a FULL credential for that Telegram account — read and write, no second
# factor. Treat it exactly like a password: never commit it, never paste it into
# a chat or a PR. The account must be a member of ABA_TELEGRAM_GROUP_ID.
TELEGRAM_SESSION=

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Number of reverse proxies in front of the app (0 = exposed directly).
# Rate limiting keys on the client IP, and behind a proxy `req.ip` is the
# proxy's address unless this is set — which would put every user in one
# shared bucket. Set to 1 for a single nginx/Coolify hop.
# Do NOT set this higher than the real hop count: each extra hop trusted is one
# more `X-Forwarded-For` entry a client can forge to escape its own bucket.
TRUST_PROXY_HOPS=0

# ---------------------------------------------------------------------------
# Database (native PostgreSQL)
# ---------------------------------------------------------------------------
# Development: PostgreSQL installed natively on the host and managed by systemd
# (`sudo systemctl status postgresql@18-main`), not Docker and not Supabase.
# Create the database once with:
#   sudo -u postgres createdb -p 5434 -O postgres derlg_dev
#
# Port 5434 rather than 5432: the cluster picks the first free port at install
# time. Confirm yours with `pg_lsclusters` before copying this value.
#
# Production: point both at the Coolify-managed Postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/derlg_dev
DIRECT_URL=postgresql://postgres:postgres@localhost:5434/derlg_dev

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# Native Redis managed by systemd (`sudo systemctl status redis-server`), with
# `port 6380` set in /etc/redis/redis.conf. 6380 rather than the default 6379
# because 6379 may already be bound on the host — check `ss -lnt`.
# The AI agent must use the same instance: the admin AI-session endpoint reads
# the `session:{id}` keys the agent writes, so a split Redis silently breaks
# session lookups.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/derlg_dev
DIRECT_URL=postgresql://postgres:postgres@localhost:5434/derlg_dev

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# Published on 6380 by backend/docker-compose.yml to avoid colliding with any
# other Redis already bound to 6379 on the host. The AI agent must use the same
# instance: the admin AI-session endpoint reads the `session:{id}` keys the agent
# writes, so a split Redis silently breaks session lookups.
# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# Option A: Connection string
REDIS_URL=redis://localhost:6380/0
# Option B: Component-based (used by some Redis clients)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# ---------------------------------------------------------------------------
# MinIO (Object Storage)
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=derlg-storage

# ---------------------------------------------------------------------------
# Auth (JWT)
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---------------------------------------------------------------------------
# Sandbox demo payments
# ---------------------------------------------------------------------------
# Stripe and ABA are configured near the top of this file.
#
# When 'true', POST /v1/bookings/:id/confirm marks a booking paid WITHOUT a real
# charge. Superseded by the real providers and kept only for local demos and
# seeded fixtures. Leave false in production: it is an authenticated endpoint that
# grants a free booking to anyone who calls it.
DEMO_PAYMENTS=false

# ---------------------------------------------------------------------------
# AI Service
# ---------------------------------------------------------------------------
AI_SERVICE_KEY=

# ---------------------------------------------------------------------------
# External Services (Optional for Phase 0)
# ---------------------------------------------------------------------------
# Resend API key for transactional email
RESEND_API_KEY=
# Firebase Cloud Messaging server key
FCM_SERVER_KEY=
# ExchangeRate-API key
EXCHANGE_RATE_API_KEY=

# ---------------------------------------------------------------------------
# Frontend URL (for password reset links, email templates)
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Booking Engine (Phase 5)
# ---------------------------------------------------------------------------
# Hold-key TTL in seconds. 900s (15 min) is the spec default per
# CONSTITUTION.md § 9.1. Test fixtures may override.
BOOKING_HOLD_TTL_SECONDS=900


# ---------------------------------------------------------------------------
# Telegram Driver Bot (admin panel — merged from derlg-system-admin)
# ---------------------------------------------------------------------------
# Feature flag. Disabled by default so the public API boots without a bot token.
TELEGRAM_BOT_ENABLED=false
# From BotFather.
TELEGRAM_BOT_TOKEN=
# Public HTTPS URL of POST /v1/telegram/webhook.
TELEGRAM_WEBHOOK_URL=
# Random 32+ char secret; checked against Telegram's
# X-Telegram-Bot-Api-Secret-Token header on every webhook call.
TELEGRAM_SECRET_TOKEN=
TELEGRAM_LOCATION_TRACKING_ENABLED=false
TELEGRAM_BROADCAST_ENABLED=false

# ---------------------------------------------------------------------------
# Admin panel seeding
# ---------------------------------------------------------------------------
# Password applied to the seeded admin accounts. Optional in development (the
# seed falls back to a dev-only value); REQUIRED when NODE_ENV=production, where
# the seed aborts rather than create a well-known password.
SEED_ADMIN_PASSWORD=
