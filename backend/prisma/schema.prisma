// =============================================================================
// DerLg — Prisma Database Schema
// =============================================================================
// Version: 1.0
// Covers: MVP (launch) + v1.1 (retention) + v1.2 (maturity) + v2.0 (growth)
//
// Conventions:
//  - UUID primary keys on all tables
//  - TIMESTAMPTZ for all timestamp columns
//  - DECIMAL(10,2) for monetary values
//  - JSONB for flexible / extensible structures
//  - TEXT[] for multi-value arrays (tags, images)
//  - snake_case table names via @@map
//  - All FKs indexed for query performance
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  // DATABASE_URL → pooled (PgBouncer, port 6543) for Prisma Client queries
  // DIRECT_URL   → direct  (port 5432)         for prisma migrate commands
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  user
  guide
  admin
  student // granted after verification (F62)
  super_admin
  operations_manager
  fleet_manager
  support_agent

  @@map("user_role")
}

enum UserStatus {
  active
  inactive
  suspended

  @@map("user_status")
}

enum BookingStatus {
  hold // active hold, payment pending (was "reserved")
  pending_payment // user has clicked pay; Stripe PaymentIntent created
  confirmed // payment succeeded
  cancelled // user/admin cancelled
  expired // hold timer elapsed without payment
  payment_failed // Stripe webhook reported failure
  completed // trip/service delivered
  no_show // user did not show up

  @@map("booking_status")
}

enum BookingType {
  trip_package
  hotel_room
  transportation
  tour_guide

  @@map("booking_type")
}

enum BookingMethod {
  public_package // M1: fixed product, package-level capacity, atomic price
  custom_itinerary // merged M2 + M3: multi-resource itinerary (seeded from Trip template OR built from scratch)
  single_resource // M4: one resource (transportation / hotel-room / guide / single-trip)

  @@map("booking_method")
}

enum SingleResourceKind {
  transportation // M4a
  hotel // M4b
  guide // M4c
  trip // M4d

  @@map("single_resource_kind")
}

enum PaymentProvider {
  stripe
  bakong
  // ABA Bank KHQR. Distinct from `bakong` even though both ride the KHQR rail:
  // ABA payments are confirmed out-of-band from a Telegram credit alert rather
  // than by polling a provider API, so every lookup has to be able to tell them
  // apart. Treating them as one value made an ABA alert able to settle a Bakong
  // row that happened to share an amount.
  aba

  @@map("payment_provider")
}

enum PaymentStatus {
  pending
  processing
  succeeded
  failed
  refunded
  partially_refunded

  @@map("payment_status")
}

enum DiscountType {
  percentage
  fixed_amount

  @@map("discount_type")
}

enum LoyaltyTransactionType {
  earned
  redeemed
  adjusted
  expired
  referral

  @@map("loyalty_transaction_type")
}

enum VerificationStatus {
  pending
  approved
  rejected

  @@map("verification_status")
}

enum EmergencyAlertType {
  sos
  medical
  theft
  lost

  @@map("emergency_alert_type")
}

enum EmergencyAlertStatus {
  triggered
  acknowledged
  resolved
  cancelled

  @@map("emergency_alert_status")
}

enum NotificationChannel {
  email
  push
  in_app

  @@map("notification_channel")
}

enum NotificationStatus {
  pending
  sent
  delivered
  failed
  read

  @@map("notification_status")
}

enum SupportedLanguage {
  en
  zh
  km
  ja
  ko
  fr
  de
  es
  th
  vi

  @@map("supported_language")
}

enum PlaceCategory {
  temple
  museum
  nature
  market
  beach
  mountain

  @@map("place_category")
}

enum TripCategory {
  temples
  nature
  culture
  adventure
  food
  custom // AI-composed custom trip (P6b)

  @@map("trip_category")
}

enum VehicleType {
  tuk_tuk
  van
  bus

  @@map("vehicle_type")
}

enum HotelType {
  resort
  boutique
  hotel
  guesthouse
  hostel
  villa

  @@map("hotel_type")
}

enum Specialty {
  culture_history
  food_tours
  nature_trekking
  photography
  family_friendly
  business
  luxury
  adventure

  @@map("specialty")
}

enum VehicleTier {
  normal
  vip

  @@map("vehicle_tier")
}

enum VehicleSubtype {
  starex
  hiace
  alphard
  small_bus
  big_bus

  @@map("vehicle_subtype")
}

enum PricingModel {
  per_day
  per_km

  @@map("pricing_model")
}

enum AuditEventType {
  booking_created
  booking_confirmed
  booking_cancelled
  payment_succeeded
  payment_failed
  refund_issued
  loyalty_earned
  loyalty_redeemed
  user_registered
  user_login
  admin_action
  security_event

  @@map("audit_event_type")
}

// --- Admin panel & fleet operations (F110–F118) -------------------------------

enum DriverStatus {
  AVAILABLE
  BUSY
  OFFLINE

  @@map("driver_status")
}

enum MaintenanceStatus {
  SCHEDULED
  IN_MAINTENANCE
  COMPLETED

  @@map("maintenance_status")
}

enum AdminRole {
  SUPER_ADMIN
  OPERATIONS_MANAGER
  FLEET_MANAGER
  SUPPORT_AGENT

  @@map("admin_role")
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED

  @@map("assignment_status")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED

  @@map("ticket_status")
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("ticket_priority")
}

enum BroadcastStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED

  @@map("broadcast_status")
}

enum AuthProvider {
  google
  telegram
  apple
  facebook

  @@map("auth_provider")
}

// =============================================================================
// USERS & AUTH
// =============================================================================

model User {
  id                String            @id @default(uuid()) @db.Uuid
  supabaseUid       String            @unique @map("supabase_uid")
  email             String            @unique
  role              UserRole          @default(user)
  preferredLanguage SupportedLanguage @default(en) @map("preferred_language")

  // Auth
  passwordHash String? @map("password_hash") // null for OAuth-only users

  // Profile (F05)
  fullName              String? @map("full_name")
  phone                 String?
  avatarUrl             String? @map("avatar_url")
  emergencyContactName  String? @map("emergency_contact_name")
  emergencyContactPhone String? @map("emergency_contact_phone")

  // Status
  status UserStatus @default(active) @map("status")

  // Loyalty (F60)
  loyaltyPoints Int @default(0) @map("loyalty_points")

  // Student verification status (resolved via relation)
  isStudentVerified Boolean @default(false) @map("is_student_verified")

  // Referral (F64, v2.0)
  referralCode String? @unique @map("referral_code")
  referredBy   String? @map("referred_by") @db.Uuid

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  bookings             Booking[]
  reviews              Review[]
  loyaltyTransactions  LoyaltyTransaction[]
  studentVerifications StudentVerification[]
  emergencyAlerts      EmergencyAlert[]
  locationShares       LocationShare[]
  aiChatSessions       AIChatSession[]
  notifications        Notification[]
  pushDeviceTokens     PushDeviceToken[]
  auditLogs            AuditLog[]
  favorites            Favorite[]
  payments             Payment[]
  oauthAccounts        OAuthAccount[]

  // Admin panel relations (F110–F118)
  adminProfile    AdminUser?
  assignedTickets SupportTicket[]    @relation("SupportTicketAssignee")
  sentBroadcasts  BroadcastMessage[] @relation("BroadcastSender")
  createdBackups  Backup[]           @relation("BackupCreator")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenId   String    @unique @map("token_id")
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model OAuthAccount {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  provider          AuthProvider @map("provider")
  providerAccountId String       @map("provider_account_id")

  email             String?      @map("email")
  displayName       String?      @map("display_name")
  avatarUrl         String?      @map("avatar_url")

  profileData       Json?        @map("profile_data") @db.JsonB

  accessToken       String?      @map("access_token") @db.Text
  refreshToken      String?      @map("refresh_token") @db.Text
  tokenExpiresAt    DateTime?    @map("token_expires_at") @db.Timestamptz()

  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([provider, email])
  @@map("oauth_accounts")
}

// =============================================================================
// CONTENT — PLACES (F80)
// =============================================================================

model Place {
  id        String        @id @default(uuid()) @db.Uuid
  category  PlaceCategory
  latitude  Decimal       @db.Decimal(10, 7)
  longitude Decimal       @db.Decimal(10, 7)
  images    String[]      @default([]) @db.Text

  // Metadata
  entryFeeUsd  Decimal? @map("entry_fee_usd") @db.Decimal(10, 2)
  openingHours String?  @map("opening_hours") @db.Text
  dressCode    String?  @map("dress_code") @db.Text
  website      String?

  // Admin
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  translations       PlaceTranslation[]
  tripItineraryItems TripItineraryItem[]
  favorites          Favorite[]

  @@index([category])
  @@index([isPublished])
  @@map("places")
}

model PlaceTranslation {
  id          String            @id @default(uuid()) @db.Uuid
  placeId     String            @map("place_id") @db.Uuid
  language    SupportedLanguage
  name        String
  description String?           @db.Text
  visitorTips String?           @map("visitor_tips") @db.Text
  address     String?

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, language])
  @@index([placeId])
  @@map("place_translations")
}

// =============================================================================
// CONTENT — TRIPS / PACKAGES (F20–F22)
// =============================================================================

model Trip {
  id           String       @id @default(uuid()) @db.Uuid
  category     TripCategory
  durationDays Int          @map("duration_days")

  // Pricing
  basePriceUsd Decimal @map("base_price_usd") @db.Decimal(10, 2)
  maxCapacity  Int     @default(10) @map("max_capacity")

  // AI-composed custom trips (P6b): server-priced component extras snapshot.
  extras Json? @db.JsonB

  // Cover
  coverImage String?  @map("cover_image")
  images     String[] @default([]) @db.Text

  // Meta
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  translations       TripTranslation[]
  itineraryItems     TripItineraryItem[]
  guides             Guide[] // implicit m2m — trip packages a guide runs (P2)
  reviews            Review[]
  favorites          Favorite[]
  bookingItems       BookingItem[]
  bookingsAsTemplate Booking[]           @relation("BookingTripTemplate")

  @@index([category])
  @@index([isPublished])
  @@map("trips")
}

model TripTranslation {
  id                 String            @id @default(uuid()) @db.Uuid
  tripId             String            @map("trip_id") @db.Uuid
  language           SupportedLanguage
  title              String
  subtitle           String?
  description        String?           @db.Text
  includedItems      String[]          @default([]) @map("included_items") @db.Text
  excludedItems      String[]          @default([]) @map("excluded_items") @db.Text
  cancellationPolicy String?           @map("cancellation_policy") @db.Text
  meetingPoint       String?           @map("meeting_point")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, language])
  @@index([tripId])
  @@map("trip_translations")
}

model TripItineraryItem {
  id        String @id @default(uuid()) @db.Uuid
  tripId    String @map("trip_id") @db.Uuid
  dayNumber Int    @map("day_number")
  sortOrder Int    @default(0) @map("sort_order")

  // Optional links to other entities
  placeId String? @map("place_id") @db.Uuid
  hotelId String? @map("hotel_id") @db.Uuid

  // Relations
  trip         Trip                           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  place        Place?                         @relation(fields: [placeId], references: [id], onDelete: SetNull)
  hotel        Hotel?                         @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  translations TripItineraryItemTranslation[]

  @@index([tripId, dayNumber, sortOrder])
  @@map("trip_itinerary_items")
}

model TripItineraryItemTranslation {
  id              String            @id @default(uuid()) @db.Uuid
  itineraryItemId String            @map("itinerary_item_id") @db.Uuid
  language        SupportedLanguage
  title           String
  description     String?           @db.Text

  itineraryItem TripItineraryItem @relation(fields: [itineraryItemId], references: [id], onDelete: Cascade)

  @@unique([itineraryItemId, language])
  @@index([itineraryItemId])
  @@map("trip_itinerary_item_translations")
}

// =============================================================================
// CONTENT — FESTIVALS (F81, v1.2)
// =============================================================================

model Festival {
  id          String   @id @default(uuid()) @db.Uuid
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  province    String?
  images      String[] @default([]) @db.Text
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  translations  FestivalTranslation[]
  discountCodes DiscountCode[]

  @@index([startDate, endDate])
  @@map("festivals")
}

model FestivalTranslation {
  id          String            @id @default(uuid()) @db.Uuid
  festivalId  String            @map("festival_id") @db.Uuid
  language    SupportedLanguage
  name        String
  description String?           @db.Text
  location    String?

  festival Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  @@unique([festivalId, language])
  @@index([festivalId])
  @@map("festival_translations")
}

// =============================================================================
// HOTELS (F31)
// =============================================================================

model Hotel {
  id          String     @id @default(uuid()) @db.Uuid
  latitude    Decimal    @db.Decimal(10, 7)
  longitude   Decimal    @db.Decimal(10, 7)
  type        HotelType? @map("type")
  starRating  Int?       @map("star_rating")
  images      String[]   @default([]) @db.Text
  amenities   String[]   @default([]) @db.Text
  isPublished Boolean    @default(false) @map("is_published")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  translations HotelTranslation[]
  rooms        HotelRoom[]
  reviews      Review[]
  favorites    Favorite[]
  tripItems    TripItineraryItem[]

  @@index([isPublished])
  @@index([type])
  @@map("hotels")
}

model HotelTranslation {
  id          String            @id @default(uuid()) @db.Uuid
  hotelId     String            @map("hotel_id") @db.Uuid
  language    SupportedLanguage
  name        String
  address     String?
  description String?           @db.Text

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, language])
  @@index([hotelId])
  @@map("hotel_translations")
}

model HotelRoom {
  id           String   @id @default(uuid()) @db.Uuid
  hotelId      String   @map("hotel_id") @db.Uuid
  roomType     String   @map("room_type") @db.Text // e.g. "Single", "Double", "Suite"
  maxOccupancy Int      @default(2) @map("max_occupancy")
  priceUsd     Decimal  @map("price_usd") @db.Decimal(10, 2)
  amenities    String[] @default([]) @db.Text
  images       String[] @default([]) @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  hotel        Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  bookingItems BookingItem[]

  @@index([hotelId])
  @@map("hotel_rooms")
}

// =============================================================================
// TRANSPORTATION (F32)
// =============================================================================

model TransportationVehicle {
  id           String          @id @default(uuid()) @db.Uuid
  vehicleType  VehicleType     @map("vehicle_type")
  tier         VehicleTier?    @map("tier")
  subtype      VehicleSubtype? @map("subtype")
  name         String
  licensePlate String?         @map("license_plate")

  // Capacity & Pricing
  capacity     Int          @default(4)
  pricingModel PricingModel @map("pricing_model")
  priceUsd     Decimal      @map("price_usd") @db.Decimal(10, 2)

  // Operational
  province  String
  images    String[] @default([]) @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  bookingItems BookingItem[]

  // Admin panel relations (F110–F118)
  drivers            Driver[]
  maintenanceRecords VehicleMaintenance[]
  driverAssignments  DriverAssignment[]

  @@index([vehicleType])
  @@index([tier])
  @@index([subtype])
  @@index([province])
  @@index([isActive])
  @@map("transportation_vehicles")
}

// =============================================================================
// TOUR GUIDES (F33)
// =============================================================================

model Guide {
  id     String @id @default(uuid()) @db.Uuid
  // Maps to users table for guide login
  userId String @unique @map("user_id") @db.Uuid

  // Profile
  bio       String?
  avatarUrl String?  @map("avatar_url")
  images    String[] @default([]) @db.Text

  // Pricing
  pricePerDayUsd Decimal @map("price_per_day_usd") @db.Decimal(10, 2)

  // Verification
  isVerified Boolean @default(false) @map("is_verified")

  // Location
  province  String
  provinces String[] @default([]) @db.Text // multi-province coverage

  // Active
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  languages    GuideLanguage[]
  specialties  GuideSpecialty[]
  trips        Trip[] // implicit m2m — packages this guide runs (P2)
  reviews      Review[]
  bookingItems BookingItem[]
  favorites    Favorite[]

  @@index([province])
  @@index([isVerified])
  @@index([isActive])
  @@map("guides")
}

model GuideLanguage {
  id       String            @id @default(uuid()) @db.Uuid
  guideId  String            @map("guide_id") @db.Uuid
  language SupportedLanguage

  guide Guide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@unique([guideId, language])
  @@map("guide_languages")
}

model GuideSpecialty {
  id        String    @id @default(uuid()) @db.Uuid
  guideId   String    @map("guide_id") @db.Uuid
  specialty Specialty

  guide Guide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@unique([guideId, specialty])
  @@map("guide_specialties")
}

// =============================================================================
// BOOKINGS — Core Engine (F30–F38)
// =============================================================================

model Booking {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  reference String @unique

  // NEW — method tagging (per booking-methods.md)
  method             BookingMethod
  singleResourceKind SingleResourceKind? @map("single_resource_kind")

  // NEW — link to the Trip that seeded this itinerary, if any.
  // Null for build-from-scratch, public-package, or single-resource bookings.
  // Populated for "private package" bookings to enable bundle-discount comparisons
  // and analytics ("how many people booked from Package X?").
  tripTemplateId String? @map("trip_template_id") @db.Uuid

  // Dates
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  // Status & Hold
  status    BookingStatus @default(hold)
  expiresAt DateTime      @map("expires_at") @db.Timestamptz()

  // Financials (unchanged)
  subtotalUsd        Decimal @map("subtotal_usd") @db.Decimal(10, 2)
  discountUsd        Decimal @default(0) @map("discount_usd") @db.Decimal(10, 2)
  loyaltyDiscountUsd Decimal @default(0) @map("loyalty_discount_usd") @db.Decimal(10, 2)
  totalUsd           Decimal @map("total_usd") @db.Decimal(10, 2)

  // Cancellation (unchanged)
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz()
  cancelReason     String?   @map("cancel_reason") @db.Text
  refundPercentage Int?      @map("refund_percentage")

  qrCodeUrl      String? @map("qr_code_url")
  passengerCount Int     @default(1) @map("passenger_count")
  roomCount      Int     @default(1) @map("room_count")

  // Timestamps + soft delete
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz() // NEW

  user         User           @relation(fields: [userId], references: [id])
  tripTemplate Trip?          @relation("BookingTripTemplate", fields: [tripTemplateId], references: [id], onDelete: SetNull)
  items        BookingItem[]
  payments     Payment[]
  notification Notification[]

  // Admin panel relations (F110–F118)
  driverAssignments DriverAssignment[]

  @@index([userId])
  @@index([status])
  @@index([method]) // NEW
  @@index([tripTemplateId]) // NEW
  @@index([expiresAt])
  @@index([startDate])
  @@index([createdAt])
  @@index([deletedAt]) // NEW
  @@map("bookings")
}

model BookingItem {
  id          String      @id @default(uuid()) @db.Uuid
  bookingId   String      @map("booking_id") @db.Uuid
  bookingType BookingType @map("booking_type")

  // Polymorphic refs — exactly one is populated per item (kept as-is)
  tripId      String? @map("trip_id") @db.Uuid
  hotelRoomId String? @map("hotel_room_id") @db.Uuid
  vehicleId   String? @map("vehicle_id") @db.Uuid
  guideId     String? @map("guide_id") @db.Uuid

  // NEW — per-item interval (replaces `date`)
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date

  // Per-item details (unchanged)
  quantity     Int     @default(1)
  unitPriceUsd Decimal @map("unit_price_usd") @db.Decimal(10, 2)
  subtotalUsd  Decimal @map("subtotal_usd") @db.Decimal(10, 2)

  // NEW — frozen resource state at booking time (cancellation policy, names, snapshots)
  snapshot Json

  booking   Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  trip      Trip?                  @relation(fields: [tripId], references: [id], onDelete: SetNull)
  hotelRoom HotelRoom?             @relation(fields: [hotelRoomId], references: [id], onDelete: SetNull)
  vehicle   TransportationVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  guide     Guide?                 @relation(fields: [guideId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([bookingType])
  @@index([tripId])
  @@index([hotelRoomId])
  @@index([vehicleId])
  @@index([guideId])
  @@index([startDate, endDate]) // NEW — supports overlap query
  @@map("booking_items")
}

// =============================================================================
// PAYMENTS (F40–F47)
// =============================================================================

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  bookingId         String          @map("booking_id") @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  provider PaymentProvider
  /// Provider-side settlement id: a Stripe charge id, or an ABA transaction id
  /// from the Telegram credit alert.
  ///
  /// Unique, and that uniqueness is the idempotency guarantee for settlement.
  /// Stripe redelivers webhooks and Telegram can replay a message on reconnect;
  /// without a DB-level constraint, a replayed event would settle a payment
  /// twice. Postgres allows unlimited NULLs in a unique index, so unsettled rows
  /// are unaffected.
  providerPaymentId String? @unique @map("provider_payment_id")

  // Amounts
  amountUsd    Decimal  @map("amount_usd") @db.Decimal(10, 2)
  currency     String   @default("usd")
  exchangeRate Decimal? @default(1.0) @map("exchange_rate") @db.Decimal(10, 6)

  // Status
  status            PaymentStatus @default(pending)
  refundedAmountUsd Decimal       @default(0) @map("refunded_amount_usd") @db.Decimal(10, 2)

  // Stripe-specific
  stripePaymentIntentId String? @map("stripe_payment_intent_id")
  clientSecret          String? @map("client_secret")

  // QR (KHQR — Bakong and ABA)
  //
  // `qrPayload` is the EMVCo/KHQR string the customer's banking app decodes. It
  // is the payment instrument, so it is persisted: re-deriving it would mint a
  // new expiry and silently invalidate the code already on the customer's screen.
  // The PNG is rendered on demand from this string and never stored.
  qrPayload   String?   @map("qr_payload")
  qrCodeUrl   String?   @map("qr_code_url")
  qrExpiresAt DateTime? @map("qr_expires_at") @db.Timestamptz()

  // Idempotency (F43)
  idempotencyKey String? @unique @map("idempotency_key")

  // Timestamps
  paidAt    DateTime? @map("paid_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  booking Booking  @relation(fields: [bookingId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
  refunds Refund[]

  @@index([bookingId])
  @@index([userId])
  @@index([provider])
  @@index([status])
  @@index([stripePaymentIntentId])
  // The ABA Telegram listener's hot path: find the pending payment for an exact
  // amount from a specific provider. Without this it is a full scan of `payments`
  // on every credit alert, and it runs while a customer waits at a QR code.
  @@index([provider, status, amountUsd])
  @@map("payments")
}

model Refund {
  id               String  @id @default(uuid()) @db.Uuid
  paymentId        String  @map("payment_id") @db.Uuid
  amountUsd        Decimal @map("amount_usd") @db.Decimal(10, 2)
  providerRefundId String? @map("provider_refund_id")

  // Tier info (F37/F44)
  reason     String @db.Text
  percentage Int // 100, 50, or 0

  // Status
  status PaymentStatus @default(pending)

  // Metadata
  processedById String?  @map("processed_by_id") @db.Uuid // admin (Bakong manual)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("refunds")
}

model StripeEvent {
  id            String   @id @default(uuid()) @db.Uuid
  stripeEventId String   @unique @map("stripe_event_id")
  eventType     String   @map("event_type")
  processedAt   DateTime @default(now()) @map("processed_at") @db.Timestamptz()

  @@index([stripeEventId])
  @@map("stripe_events")
}

// =============================================================================
// DISCOUNT CODES (F46, v1.1)
