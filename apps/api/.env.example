# ---- Runtime ----
NODE_ENV=development
PORT=3101
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3100

# ---- PostgreSQL (docker-compose maps 5432 -> 55433 to avoid local conflicts) ----
DATABASE_URL=postgresql://derlg:derlg_dev_password@localhost:55433/derlg?schema=public

# ---- Redis (docker-compose maps 6379 -> 56380) ----
REDIS_URL=redis://localhost:56380

# ---- Auth ----
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-dev-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-dev-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Leave empty in local development so the cookie works on localhost.
COOKIE_DOMAIN=

# ---- Stripe (optional: payment endpoints return 503 until these are set) ----
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# From: stripe listen --forward-to localhost:3101/v1/payments/webhook
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---- LLM (OpenAI-compatible API; NVIDIA NIM by default) ----
# Swap provider by changing the base URL and key only — no code changes.
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=
# Verified working on NVIDIA NIM with tool calling:
#   meta/llama-3.1-8b-instruct   (fast: ~0.8s to first token — default)
#   meta/llama-3.1-70b-instruct  (better prose, much slower to stream)
OPENAI_MODEL=meta/llama-3.1-8b-instruct
OPENAI_TIMEOUT_MS=60000
