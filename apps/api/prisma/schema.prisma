// DerLg data model — MVP.
//
// Money is stored as integer cents (never floats) in the `*Cents` columns.
// Tables are snake_case per .kiro/steering/conventions.md.
//
// Polymorphic references: `PackageDayItem.refId`, `JourneyDraftItem`-in-snapshot
// and `BookingItem.refId` point at a Place / Hotel / Transport / Guide row
// depending on `type`. There is no database FK for these on purpose (one column
// cannot reference four tables); every write path verifies the id exists via
// CatalogRefResolver before persisting. That verification is also the guard that
// stops the AI from inventing ids.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- identity

enum UserRole {
  TRAVELER
  ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         UserRole @default(TRAVELER)
  locale       String   @default("en")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  drafts        JourneyDraft[]
  bookings      Booking[]
  conversations Conversation[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------- catalog

model City {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  country   String   @default("Cambodia")
  latitude  Float
  longitude Float
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  places             Place[]
  hotels             Hotel[]
  guides             Guide[]
  packages           Package[]
  transportsFrom     Transport[] @relation("TransportOrigin")
  transportsTo       Transport[] @relation("TransportDestination")

  @@map("cities")
}

enum PlaceCategory {
  TEMPLE
  MUSEUM
  MARKET
  NATURE
  LANDMARK
  ENTERTAINMENT
  FOOD
}

model Place {
  id                   String        @id @default(uuid()) @db.Uuid
  slug                 String        @unique
  name                 String
  cityId               String        @map("city_id") @db.Uuid
  description          String
  category             PlaceCategory
  latitude             Float
  longitude            Float
  entranceFeeCents     Int           @default(0) @map("entrance_fee_cents")
  visitDurationMinutes Int           @default(90) @map("visit_duration_minutes")
  dailyCapacity        Int           @default(200) @map("daily_capacity")
  mapsUrl              String?       @map("maps_url")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  city   City         @relation(fields: [cityId], references: [id], onDelete: Cascade)
  images PlaceImage[]

  @@index([cityId])
  @@index([category])
  @@map("places")
}

/// Image attribution is a licence obligation (most seed photos are CC BY-SA):
/// `author` / `license` / `sourceUrl` must stay visible wherever the image renders.
model PlaceImage {
  id        String @id @default(uuid()) @db.Uuid
  placeId   String @map("place_id") @db.Uuid
  url       String
  position  Int
  author    String?
  license   String?
  sourceUrl String? @map("source_url")

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, position])
  @@map("place_images")
}

model Hotel {
  id                 String   @id @default(uuid()) @db.Uuid
  slug               String   @unique
  name               String
  cityId             String   @map("city_id") @db.Uuid
  description        String
  address            String
  starRating         Int      @map("star_rating")
  pricePerNightCents Int      @map("price_per_night_cents")
  amenities          String[]
  imageUrl           String?  @map("image_url")
  roomsPerNight      Int      @default(10) @map("rooms_per_night")
  latitude           Float
  longitude          Float
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([cityId])
  @@map("hotels")
}

enum TransportKind {
  VAN
  BUS
  TUKTUK
  PRIVATE_CAR
}

model Transport {
  id                 String        @id @default(uuid()) @db.Uuid
  slug               String        @unique
  kind               TransportKind
  operator           String
  originCityId       String        @map("origin_city_id") @db.Uuid
  destinationCityId  String        @map("destination_city_id") @db.Uuid
  departureTime      String        @map("departure_time")
  durationMinutes    Int           @map("duration_minutes")
  pricePerSeatCents  Int           @map("price_per_seat_cents")
  seatsPerDeparture  Int           @default(12) @map("seats_per_departure")
  imageUrl           String?       @map("image_url")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  originCity      City @relation("TransportOrigin", fields: [originCityId], references: [id], onDelete: Cascade)
  destinationCity City @relation("TransportDestination", fields: [destinationCityId], references: [id], onDelete: Cascade)

  @@index([originCityId, destinationCityId])
  @@map("transports")
}

model Guide {
  id               String   @id @default(uuid()) @db.Uuid
  slug             String   @unique
  fullName         String   @map("full_name")
  cityId           String   @map("city_id") @db.Uuid
  bio              String
  languages        String[]
  pricePerDayCents Int      @map("price_per_day_cents")
  rating           Float    @default(4.5)
  yearsExperience  Int      @default(3) @map("years_experience")
  avatarUrl        String?  @map("avatar_url")
  dailyCapacity    Int      @default(1) @map("daily_capacity")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([cityId])
  @@map("guides")
}

enum PackageKind {
  PUBLIC
  PRIVATE
}

enum PricingMode {
  PER_PERSON
  PER_GROUP
}

model Package {
  id             String      @id @default(uuid()) @db.Uuid
  slug           String      @unique
  title          String
  summary        String
  cityId         String      @map("city_id") @db.Uuid
  kind           PackageKind
  pricingMode    PricingMode @default(PER_PERSON) @map("pricing_mode")
  durationDays   Int         @map("duration_days")
  basePriceCents Int         @map("base_price_cents")
  minGroupSize   Int         @default(1) @map("min_group_size")
  maxGroupSize   Int         @default(12) @map("max_group_size")
  kidFriendly    Boolean     @default(true) @map("kid_friendly")
  featured       Boolean     @default(false)
  heroImageUrl   String?     @map("hero_image_url")
  highlights     String[]
  inclusions     String[]
  exclusions     String[]
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  city     City           @relation(fields: [cityId], references: [id], onDelete: Cascade)
  days     PackageDay[]
  drafts   JourneyDraft[]
  bookings Booking[]

  @@index([cityId])
  @@index([kind])
  @@index([featured])
  @@map("packages")
}

model PackageDay {
  id        String @id @default(uuid()) @db.Uuid
  packageId String @map("package_id") @db.Uuid
  dayNumber Int    @map("day_number")
  title     String
  summary   String

  package Package          @relation(fields: [packageId], references: [id], onDelete: Cascade)
  items   PackageDayItem[]

  @@unique([packageId, dayNumber])
  @@map("package_days")
}

enum ItemType {
  PLACE
  HOTEL
  TRANSPORT
  GUIDE
  CUSTOM
}

model PackageDayItem {
  id              String   @id @default(uuid()) @db.Uuid
  dayId           String   @map("day_id") @db.Uuid
  position        Int
  type            ItemType
  /// Polymorphic id into places/hotels/transports/guides. NULL for CUSTOM items.
  refId           String?  @map("ref_id") @db.Uuid
  title           String
  description     String   @default("")
  startTime       String?  @map("start_time")
  durationMinutes Int      @default(60) @map("duration_minutes")
  priceCents      Int      @default(0) @map("price_cents")
  /// CUSTOM (AI-authored) items are never bookable and always priced zero.
  bookable        Boolean  @default(true)

  day PackageDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@unique([dayId, position])
  @@index([type, refId])
  @@map("package_day_items")
}

// ---------------------------------------------------- drafts / bookings

enum DraftSource {
  MANUAL
  AI
}

/// A customizable itinerary. `snapshot` holds the full priced day/item tree so
/// later catalog edits never mutate a user's saved plan.
model JourneyDraft {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  packageId      String?     @map("package_id") @db.Uuid
  source         DraftSource @default(MANUAL)
  title          String
  startDate      DateTime?   @map("start_date") @db.Date
  guests         Int         @default(2)
  snapshot       Json
  totalCents     Int         @map("total_cents")
  baseTotalCents Int         @map("base_total_cents")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  package  Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  bookings Booking[]

  @@index([userId])
  @@map("journey_drafts")
}

enum BookingStatus {
  HOLD
  PENDING_PAYMENT
  CONFIRMED
  EXPIRED
  CANCELLED
  COMPLETED
}

model Booking {
  id            String        @id @default(uuid()) @db.Uuid
  reference     String        @unique
  userId        String        @map("user_id") @db.Uuid
  packageId     String?       @map("package_id") @db.Uuid
  draftId       String?       @map("draft_id") @db.Uuid
  status        BookingStatus @default(HOLD)
  startDate     DateTime      @map("start_date") @db.Date
  endDate       DateTime      @map("end_date") @db.Date
  guests        Int
  totalCents    Int           @map("total_cents")
  currency      String        @default("USD")
  contactEmail  String        @map("contact_email")
  contactName   String        @map("contact_name")
  /// Frozen priced itinerary for display and receipts.
  snapshot      Json
  holdExpiresAt DateTime?     @map("hold_expires_at")
  confirmedAt   DateTime?     @map("confirmed_at")
  cancelledAt   DateTime?     @map("cancelled_at")
  checkInCode   String?       @unique @map("check_in_code")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  package  Package?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  draft    JourneyDraft? @relation(fields: [draftId], references: [id], onDelete: SetNull)
  items    BookingItem[]
  payments Payment[]

  @@index([userId])
  @@index([status])
  @@index([holdExpiresAt])
  @@map("bookings")
}

/// Queryable inventory ledger. `Booking.snapshot` is for display; these rows are
/// what the availability engine counts against resource capacity.
model BookingItem {
  id             String   @id @default(uuid()) @db.Uuid
  bookingId      String   @map("booking_id") @db.Uuid
  dayNumber      Int      @map("day_number")
  type           ItemType
  refId          String?  @map("ref_id") @db.Uuid
  title          String
  date           DateTime @db.Date
  quantity       Int      @default(1)
  unitPriceCents Int      @map("unit_price_cents")
  totalCents     Int      @map("total_cents")
  bookable       Boolean  @default(true)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([type, refId, date])
  @@index([bookingId])
  @@map("booking_items")
}

enum PaymentStatus {
  REQUIRES_PAYMENT
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  bookingId             String        @map("booking_id") @db.Uuid
  provider              String        @default("stripe")
  stripePaymentIntentId String?       @unique @map("stripe_payment_intent_id")
  status                PaymentStatus @default(REQUIRES_PAYMENT)
  amountCents           Int           @map("amount_cents")
  currency              String        @default("USD")
  refundedCents         Int           @default(0) @map("refunded_cents")
  failureReason         String?       @map("failure_reason")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("payments")
}

// ---------------------------------------------------------- vibe booking

enum MessageRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String?
  stage     String   @default("GREETING")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  role           MessageRole
  content        String
  /// Typed payload consumed by the frontend Content Stage renderers.
  contentPayload Json?       @map("content_payload")
  toolName       String?     @map("tool_name")
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}
