# LLM Provider — NVIDIA NIM (OpenAI-compatible)
NVIDIA_API_KEY=
MODEL_LLM=openai/gpt-oss-120b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# NestJS backend base URL
BACKEND_URL=http://localhost:3001

# 32+ character service key for backend auth (X-Service-Key header)
AI_SERVICE_KEY=

# Redis connection string
# Must be the SAME instance the backend uses (backend/.env REDIS_URL). The admin
# panel's AI-session endpoint reads the `session:{id}` keys this agent writes; if
# the two point at different Redis instances every session lookup silently 404s.
REDIS_URL=redis://localhost:6380/0

# JWT secret for WebSocket auth (same as backend JWT_ACCESS_SECRET)
JWT_SECRET=

# Comma-separated origins allowed to open the chat WebSocket (CSWSH guard)
ALLOWED_WS_ORIGINS=https://derlg.com,https://www.derlg.com,http://localhost:3000

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Optional: Sentry error tracking
SENTRY_DSN=
