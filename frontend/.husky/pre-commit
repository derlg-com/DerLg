#!/usr/bin/env sh
# DerLg monorepo: .git lives at the repo root while the Next.js app lives in
# frontend/. Husky's hooksPath is set to frontend/.husky, so this hook runs from
# the repo root. We scope the frontend pre-commit checks to the frontend/ subdir.
#
# lint-staged only acts on staged files matched by the patterns in
# frontend/package.json, so commits that touch only backend/ or vibe-booking/
# files are unaffected (lint-staged exits cleanly with nothing to do).

cd frontend || exit 1
npx lint-staged
