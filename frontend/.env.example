# Backend API (NestJS on VPS)
NEXT_PUBLIC_API_URL=http://localhost:3003

# AI Agent WebSocket (FastAPI on VPS) — use wss:// in production
NEXT_PUBLIC_AI_WS_URL=ws://localhost:8000

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (publishable key only — safe to expose)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# Payments provider toggle — "rest" wires the live backend /v1/payments/* contract.
# Leave unset (or any other value) to use the built-in mock provider in dev.
NEXT_PUBLIC_PAYMENTS_PROVIDER=

# Google Maps (browser-exposed by design — restrict by HTTP referrer in Google Cloud Console)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SENTRY_DSN=

# Customer support contact (shown on booking confirmation — Requirement 39.7).
# Optional: safe generic defaults are used in dev if unset.
NEXT_PUBLIC_SUPPORT_EMAIL=support@derlg.com
NEXT_PUBLIC_SUPPORT_PHONE=+855 23 900 100
