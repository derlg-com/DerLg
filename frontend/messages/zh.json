  "legal": {
    "lastUpdated": "最后更新：2026 年 1 月 1 日",
    "terms": {
      "title": "服务条款",
      "sections": {
        "acceptance": {
          "heading": "接受条款",
          "body": "使用 DerLg 探索和预订柬埔寨的旅行体验，即表示您同意本服务条款。如不同意，请勿使用本平台。本内容为占位示例，不构成法律意见。"
        },
        "bookings": {
          "heading": "预订",
          "body": "当您通过 DerLg 预订行程、酒店、交通或向导时，即与该服务的提供方达成协议。我们会确认可用性，并在您完成支付期间为您保留所选项目一段时间。价格默认以美元显示，也可按参考汇率以柬埔寨瑞尔或人民币显示。"
        },
        "payments": {
          "heading": "支付",
          "body": "支付由持牌服务商处理。我们支持通过 Stripe 使用国际银行卡，以及通过 Bakong 和 ABA 使用本地二维码付款。DerLg 绝不会存储您的完整银行卡信息。只有在支付成功完成后，预订才会被确认。"
        },
        "cancellations": {
          "heading": "取消与退款",
          "body": "大多数预订适用我们的标准退款政策：在开始日期前至少 7 天取消可获 100% 退款；提前 1 至 7 天取消可获 50% 退款；不足 24 小时取消则不予退款。部分提供方可能设定自己的条款，将在预订时向您显示。"
        },
        "conduct": {
          "heading": "您的责任",
          "body": "您同意提供准确的信息，合法使用本平台，并在柬埔寨旅行期间尊重与您接触的提供方、向导和当地社区。您有责任确保持有行程所需的签证、许可或证件。"
        },
        "liability": {
          "heading": "责任限制",
          "body": "DerLg 仅为旅客与独立服务提供方牵线搭桥，对这些提供方的行为或疏忽不承担责任。在法律允许的范围内，我们对任何预订的责任以您为该预订支付的金额为限。本内容为占位示例，不构成法律意见。"
        },
        "changes": {
          "heading": "条款变更",
          "body": "随着平台的发展，我们可能会不时更新本条款。我们将在此处发布修订后的条款并更新上方日期。变更生效后继续使用 DerLg 即表示您接受更新后的条款。"
        }
      }
    },
    "privacy": {
      "title": "隐私政策",
      "sections": {
        "intro": {
          "heading": "简介",
          "body": "本隐私政策说明 DerLg 在您使用我们的柬埔寨旅行预订平台时如何收集、使用和保护您的个人信息。本内容为占位示例，不构成法律意见。"
        },
        "dataCollected": {
          "heading": "我们收集的信息",
          "body": "当您创建个人资料或进行预订时，我们会收集您提供的信息，例如姓名、电子邮箱、电话号码和旅行偏好。我们还会收集技术数据，例如您的设备类型、大致位置以及您如何使用应用。"
        },
        "dataUse": {
          "heading": "我们如何使用您的信息",
          "body": "我们使用您的信息来确认和管理您的预订、处理支付、提供英文、中文和高棉文的客户支持、个性化推荐以及保障平台安全。我们不会出售您的个人信息。"
        },
        "dataSharing": {
          "heading": "我们如何共享您的信息",
          "body": "我们仅与相关提供方（如酒店、交通运营商和向导）共享完成预订所需的信息。为完成交易，我们也会与支付处理方（Stripe、Bakong 和 ABA）共享数据。在柬埔寨法律要求时，我们可能会披露相关信息。"
        },
        "dataRetention": {
          "heading": "我们保留数据的期限",
          "body": "在您的账户处于活动状态期间，以及为提供服务、遵守法律义务、解决争议和执行协议所需的期间内，我们会保留您的个人信息。您可随时在个人资料中要求删除您的账户。"
        },
        "rights": {
          "heading": "您的权利",
          "body": "您可以通过个人资料设置或联系我们来访问、更正或删除您的个人信息。您也可以选择接收哪些通知，并随时管理您的语言和货币偏好。"
        },
        "contact": {
          "heading": "联系我们",
          "body": "如对本隐私政策或我们处理数据的方式有任何疑问，请通过应用联系我们的客服团队。我们将尽力在合理时间内以英文、中文或高棉文回复。"
        }
      }
    },
    "cookies": {
      "title": "Cookie 政策",
      "sections": {
        "intro": {
          "heading": "简介",
          "body": "本 Cookie 政策说明 DerLg 在我们的旅行预订平台上如何使用 Cookie 及类似技术。本内容为占位示例，不构成法律意见。"
        },
        "whatAreCookies": {
          "heading": "什么是 Cookie？",
          "body": "Cookie 是您访问网站或使用网络应用时存储在您设备上的小型文本文件。它们有助于平台记住您的偏好并了解服务的使用情况。"
        },
        "typesUsed": {
          "heading": "我们使用的 Cookie 类型",
          "body": "我们使用两类 Cookie：平台运行所必需的基本 Cookie，以及帮助我们了解并改进旅客如何使用 DerLg 的分析 Cookie。"
        },
        "essential": {
          "heading": "基本 Cookie",
          "body": "这些 Cookie 使您保持登录状态、记住您所选的语言和货币，并保护您的预订会话。没有它们平台将无法正常运行，因此无法关闭。"
        },
        "analytics": {
          "heading": "分析 Cookie",
          "body": "这些 Cookie 收集有关平台使用方式的匿名信息，例如哪些行程受欢迎以及旅客在何处遇到困难。我们借此改进预订体验。"
        },
        "managing": {
          "heading": "管理 Cookie",
          "body": "您可以通过浏览器设置控制或删除 Cookie。屏蔽基本 Cookie 可能会导致 DerLg 的部分功能（如预订和支付）无法正常运行。"
        }
      }
    }
  },
