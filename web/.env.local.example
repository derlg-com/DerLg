# =============================================================================
# DerLg web client — environment variables
# =============================================================================
# Copy to .env.local and fill in the values marked "FILL IN".
#   cp .env.local.example .env.local
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle and is
# therefore PUBLIC. Never put a secret behind a NEXT_PUBLIC_ prefix.
# =============================================================================

# --- Public: safe to expose -------------------------------------------------

# NestJS backend. Note the port is 3003 in this environment, not the 3001
# default in backend/src/main.ts.
NEXT_PUBLIC_API_URL=http://localhost:3003

# Vibe Booking AI agent WebSocket (FastAPI). Use wss:// in production.
NEXT_PUBLIC_AI_WS_URL=ws://localhost:8000

# This app's own origin. Used for share links, OG metadata and the sitemap.
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Customer support contacts shown on booking confirmations.
NEXT_PUBLIC_SUPPORT_EMAIL=support@derlg.com
NEXT_PUBLIC_SUPPORT_PHONE=+855 23 900 100

# Optional error tracking.
NEXT_PUBLIC_SENTRY_DSN=

# Stripe PUBLISHABLE key (starts with pk_). Safe to expose: it can only tokenise
# card details and confirm PaymentIntents the backend already created — it cannot
# move money on its own. This is NOT the secret key (sk_), which lives in
# backend/.env and must NEVER sit behind a NEXT_PUBLIC_ prefix. Leave empty to
# render the "card payments unavailable" state instead of booting Stripe.js.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Server-only: never sent to the browser ---------------------------------

# FILL IN — must be the EXACT same value as AI_SERVICE_KEY in backend/.env.
# Used only by the BFF route handlers in app/api/ai/* to reach the
# service-key-protected /v1/ai-tools/* endpoints. Requirements enforced by the
# backend and agent: at least 32 characters, high entropy, not a placeholder.
AI_SERVICE_KEY=
# FILL IN — must be the EXACT same value as JWT_ACCESS_SECRET in backend/.env.
# Used ONLY server-side, by the BFF route handlers, to VERIFY the signature of an
# access token before trusting its subject claim. Without it the BFF fails closed
# and treats every request as a guest.
JWT_ACCESS_SECRET=

# Optional: overrides NEXT_PUBLIC_API_URL for server-side/BFF requests. Useful
# when the browser and the server reach the backend on different hostnames
# (for example inside Docker, where the backend is `http://backend:3003`).
API_INTERNAL_URL=


# Local development only. Next 16 blocks optimising images whose host resolves to
# a private IP (SSRF protection), and the dev media store is MinIO on
# localhost:9000. Set to true locally so seeded imagery renders. NEVER set this in
# a real deployment — it would let the image endpoint probe internal services.
ALLOW_LOCAL_IMAGE_HOSTS=true

# No Google Maps key is required. Maps use Leaflet + OpenStreetMap tiles.
